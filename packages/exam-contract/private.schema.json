{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ctf-examination-studio/private.schema.json",
  "title": "CTF Examination Studio private grading rules",
  "type": "object",
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type",
          "criteria"
        ],
        "properties": {
          "type": {
            "enum": [
              "single_choice",
              "multiple_choice",
              "true_false",
              "text_entry",
              "numeric_entry",
              "matching",
              "sequencing",
              "data_inspection",
              "datatable_code",
              "code_writing",
              "web_project"
            ]
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "points",
                "answer"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "points": {
                  "type": "integer",
                  "minimum": 1
                },
                "answer": {}
              }
            }
          },
          "referenceCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "code_writing"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "properties": {
                    "criteria": {
                      "minItems": 1,
                      "maxItems": 10,
                      "items": {
                        "properties": {
                          "answer": {
                            "type": "object",
                            "required": [
                              "kind",
                              "description"
                            ],
                            "properties": {
                              "kind": {
                                "const": "manual"
                              },
                              "description": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 16000,
                                "pattern": "\\S"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "required": [
                    "referenceCode"
                  ],
                  "properties": {
                    "criteria": {
                      "minItems": 2,
                      "maxItems": 6,
                      "items": {
                        "properties": {
                          "answer": {
                            "type": "object",
                            "required": [
                              "input",
                              "output"
                            ],
                            "properties": {
                              "input": {
                                "type": "string",
                                "maxLength": 16000
                              },
                              "output": {
                                "type": "string",
                                "maxLength": 16000
                              }
                            },
                            "not": {
                              "required": [
                                "kind"
                              ],
                              "properties": {
                                "kind": {
                                  "const": "manual"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
