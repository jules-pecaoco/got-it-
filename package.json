{
  "name": "got-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import ./src/runtime-temp.mjs scripts/start-migration.mjs",
    "dev": "node --import ./src/runtime-temp.mjs scripts/start-migration.mjs --watch",
    "test": "node --import ./src/runtime-temp.mjs --import tsx --experimental-sqlite --test tests/*.test.mjs",
    "setup:coding": "node --import ./src/runtime-temp.mjs scripts/setup-coding-runtimes.mjs",
    "verify:coding": "node --import ./src/runtime-temp.mjs scripts/verify-coding-runtimes.mjs",
    "preflight": "node --import ./src/runtime-temp.mjs --import tsx --experimental-sqlite scripts/preflight.mjs",
    "backup": "node --import ./src/runtime-temp.mjs --import tsx --experimental-sqlite scripts/backup.mjs",
    "serve:local": "node --import ./src/runtime-temp.mjs scripts/serve-local.mjs",
    "prepare:local": "node --import ./src/runtime-temp.mjs scripts/prepare-local.mjs",
    "serve:preview": "node --import ./src/runtime-temp.mjs scripts/serve-preview.mjs",
    "test:load": "node --import ./src/runtime-temp.mjs --import tsx --experimental-sqlite scripts/load-test-local.mjs",
    "format": "prettier --write public/paper-copy.js public/password-toggle.js src/store-schema.mjs src/routes \"src/**/*.mts\" src/faculty-access.mjs src/migrations.mjs src/material-extraction.mjs src/material-worker.mjs src/migration-database.mjs web vite.config.mts tsconfig.json public/local-drafts.js public/web-project.js src/web-template.mjs src/runtime-temp.mjs src/ai-provider.mjs",
    "format:check": "prettier --check public/paper-copy.js public/password-toggle.js src/store-schema.mjs src/routes \"src/**/*.mts\" src/faculty-access.mjs src/migrations.mjs src/material-extraction.mjs src/material-worker.mjs src/migration-database.mjs web vite.config.mts tsconfig.json public/local-drafts.js public/web-project.js src/web-template.mjs src/runtime-temp.mjs src/ai-provider.mjs",
    "build": "node --import ./src/runtime-temp.mjs node_modules/vite/bin/vite.js build",
    "typecheck": "node --import ./src/runtime-temp.mjs node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "prestart": "npm run build",
    "pretest": "npm run build",
    "faculty": "node --import ./src/runtime-temp.mjs --import tsx --experimental-sqlite scripts/faculty.mjs",
    "restore": "node --import ./src/runtime-temp.mjs --import tsx --experimental-sqlite scripts/restore.mjs",
    "worker": "node --import ./src/runtime-temp.mjs --import tsx src/execution-worker.mts",
    "syntax:check": "node --import ./src/runtime-temp.mjs scripts/check-syntax.mjs",
    "verify:web": "node --import ./src/runtime-temp.mjs --import tsx scripts/verify-web.mts",
    "check": "npm run typecheck && npm run syntax:check && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
